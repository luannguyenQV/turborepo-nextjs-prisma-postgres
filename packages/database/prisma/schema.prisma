generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ✅ User Model with Status
model User {
  id         String     @id @default(cuid())
  name       String?
  email      String?    @unique
  username   String?    @unique
  bio        String?
  password   String?
  userStatus UserStatus @default(UNVERIFIED)

  groups        UserOnGroup[]
  posts         Post[]
  comments      Comment[]
  postOnUser    PostOnUser[]
  commentOnUser CommentOnUser[]
  userOnTag     UserOnTag[]
  followers     Follower[]      @relation("follower")
  followings    Follower[]      @relation("following")
  group         Group[]
  account       Account[]
  session       Session[]
  media         Media[]
}

// ✅ Group & UserOnGroup for Roles
model Group {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  ownerId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  mediaId     String?
  media       Media?    @relation(fields: [mediaId], references: [id])

  owner   User          @relation(fields: [ownerId], references: [id])
  members UserOnGroup[]

  @@index([deletedAt]) // Index for performance
}

model UserOnGroup {
  userId  String
  groupId String
  role    GroupRole @default(MEMBER)
  user    User      @relation(fields: [userId], references: [id])
  group   Group     @relation(fields: [groupId], references: [id])

  @@id([userId, groupId])
}

// ✅ Post with Extended Status
model Post {
  id         String     @id @default(cuid())
  title      String     @db.VarChar(255)
  content    String?
  postStatus PostStatus @default(DRAFT)
  authorId   String

  author     User         @relation(fields: [authorId], references: [id])
  comments   Comment[]
  postOnUser PostOnUser[]
  tagOnPost  TagOnPost[]
  media      Media?       @relation(fields: [mediaId], references: [id])
  mediaId    String?

  @@index([title, content]) // Full-text search optimization
}

// ✅ Comment with Nested Replies & Likes/Votes
model Comment {
  id              String  @id @default(cuid())
  content         String?
  authorId        String
  parentCommentId String?
  commentOnPostId String

  author        User @relation(fields: [authorId], references: [id])
  commentOnPost Post @relation(fields: [commentOnPostId], references: [id])

  parentComment Comment?  @relation("CommentThread", fields: [parentCommentId], references: [id])
  replies       Comment[] @relation("CommentThread")

  commentOnUser CommentOnUser[]

  @@index([parentCommentId, content]) // Faster queries for nested comments
}

// ✅ Relationships for Tagging & Following Tags
model Tag {
  id          String      @id @default(cuid())
  name        String      @unique
  type        TagType     @default(TAG)
  parentTagId String?
  tagOnPost   TagOnPost[]
  userOnTag   UserOnTag[]

  parentTag Tag?    @relation("TagTree", fields: [parentTagId], references: [id])
  children  Tag[]   @relation("TagTree")
  media     Media?  @relation(fields: [mediaId], references: [id])
  mediaId   String?

  @@index([name])
}

model TagOnPost {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id])
  tag    Tag    @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
}

model UserOnTag {
  userId String
  tagId  String
  user   User   @relation(fields: [userId], references: [id])
  tag    Tag    @relation(fields: [tagId], references: [id])

  @@id([userId, tagId])
}

// ✅ Liking & Voting on Comments & Posts
model PostOnUser {
  userId String
  postId String
  type   PostOnUserType
  user   User           @relation(fields: [userId], references: [id])
  post   Post           @relation(fields: [postId], references: [id])

  @@id([userId, postId, type])
}

model CommentOnUser {
  userId    String
  commentId String
  type      CommentOnUserType
  user      User              @relation(fields: [userId], references: [id])
  comment   Comment           @relation(fields: [commentId], references: [id])

  @@id([userId, commentId, type])
}

// ✅ Following Users (Followers System)
model Follower {
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  followerId  String
  followingId String
  follower    User     @relation("follower", fields: [followerId], references: [id])
  following   User     @relation("following", fields: [followingId], references: [id])

  @@id([followerId, followingId])
}

// ✅ Authentication & Sessions
model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ✅ Media Handling
model Media {
  id         String  @id @default(cuid())
  path       String
  name       String
  width      Int
  height     Int
  format     String
  previewUrl String?
  caption    String?
  url        String
  mime       String
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  posts      Post[]
  tags       Tag[]
  Group      Group[]

  @@index([name]) // Optimize media lookups
}

// ✅ ENUMs
enum SocialProvider {
  GOOGLE
  FACEBOOK
  TWITTER
  LINKEDIN
}

enum UserStatus {
  UNVERIFIED
  VERIFIED
  BLOCKED
}

enum GroupRole {
  MEMBER
  MODERATOR
  ADMIN
  OWNER
}

enum PostType {
  POST
  PAGE
  LIST
  COMPARE
  POLL
  QUIZ
  WIDGET
  ORGANIZATION
  SLIDE
}

enum TagType {
  TAG
  CATEGORY
}

enum PostFormat {
  STANDARD
  ASIDE
  CHAT
  GALLERY
  LINK
  IMAGE
  QUOTE
  STATUS
  VIDEO
  AUDIO
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  TRASHED
  BLOCKED
}

enum PostOnUserType {
  COMMENT
  LIKE
  FAVORITE
  FOLLOW
  BOOKMARK
  PINNED
}

enum CommentOnUserType {
  LIKE
  SHARE
  UPVOTE
  DOWNVOTE
}
